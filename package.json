{
  "name": "sql-dashboard-backend",
  "version": "1.0.0",
  "main": "dist-server/index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev:server": "nodemon --watch server -e ts --exec ts-node server/index.ts",
    "clean:server": "node -e \"const fs = require('fs'); if (fs.existsSync('dist-server')) fs.rmSync('dist-server', { recursive: true, force: true });\"",
    "build:server": "npm run clean:server && tsc -p tsconfig.server.json",
    "start:prod": "node dist-server/index.js",
    "demo": "cross-env DEMO_MODE=true PORT=4000 node dist-server/index.js"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "ibm_db": "^4.0.1",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "mssql": "^10.0.2",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0",
    "snowflake-sdk": "^3.2.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.4",
    "postject": "^1.0.0-alpha.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
